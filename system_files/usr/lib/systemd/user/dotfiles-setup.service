# First-login dotfiles populator.
#
# RakuOS creates user accounts WITHOUT a full skeleton ($HOME starts empty).
# This user unit runs at the first graphical login of each user and copies
# /etc/skel/. into $HOME (Hyprland's modular config, wallpapers, GTK/Ghostty/
# fastfetch themes, etc.).
#
# Idempotent per DE: the script exits immediately if it already ran for this
# user on this desktop environment, via a marker keyed on the image's
# /usr/share/rakuos/de-name (~/.local/share/config-setup-<de>). So on later
# boots -- and on later logins within the same image -- the unit is a no-op.
# The per-DE key is what lets a user who switches images get the new DE's
# skeleton without creating a new account. This is a oneshot that blocks login
# only while it copies, and is WantedBy=default.target to start alongside the
# session.
#
# The copy is no-clobber, so anything already in $HOME is left untouched; only
# missing files are filled in.
#
# Without this, Hyprland would boot with no config and fall back to its
# built-in defaults.
[Unit]
Description=Configure dotfiles for current user
ConditionUser=!@system

[Service]
Type=oneshot
ExecStart=/usr/libexec/dotfiles-setup.sh

[Install]
WantedBy=default.target
