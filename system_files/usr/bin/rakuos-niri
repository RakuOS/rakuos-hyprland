#!/bin/bash

COMMAND="$1"
shift

case "$COMMAND" in
    "shell")
        /usr/libexec/rakuos-niri-shell "$@"
        ;;
    "greeter"):
        /usr/libexec/rakuos-niri-greeter "$@"
        ;;
    ""|"--help"|"help"|"*"):
        echo "RakuOS Niri helper"
        echo ""
        echo "Usage:"
        echo "  shell       switch wayland shells"
        echo "  greeter     switch greetd greeters"
        echo ""
        ;;
esac
