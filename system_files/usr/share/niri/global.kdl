// This config is in the KDL format: https://kdl.dev
// System configuration
// If you want to change these, copy this file to your home folder
// and remove import in your config.kdl
//
// This configuration is separate from user config because changing any
// of these can breake things!

spawn-at-startup "bash" "-c" "wl-paste --watch cliphist store &"

environment {
  XDG_CURRENT_DESKTOP "niri"
  QT_QPA_PLATFORM "wayland"
  ELECTRON_OZONE_PLATFORM_HINT "auto"
  QT_QPA_PLATFORMTHEME "gtk3"
  QT_QPA_PLATFORMTHEME_QT6 "gtk3"
}

hotkey-overlay {
    skip-at-startup
}

config-notification {
    disable-failed
}

layer-rule {
    // match namespace="^quickshell$"
    match namespace="dms:blurwallpaper"
    place-within-backdrop true
}
layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

debug {
    honor-xdg-activation-with-invalid-serial
}

window-rule {
    match app-id="^org\\.gnome\\."
    clip-to-geometry true
}

window-rule {
    match app-id="^org\\.wezfurlong\\.wezterm$"
    match app-id="Alacritty"
    match app-id="zen"
    match app-id="com.mitchellh.ghostty"
    match app-id="kitty"
    draw-border-with-background false
}
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}
window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    open-floating true
    default-floating-position x=0 y=0 relative-to="bottom-right"
    geometry-corner-radius 0
    open-focused false
    focus-ring {
         off
    }
}
window-rule {
    match is-active=false
    opacity 0.90
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}
