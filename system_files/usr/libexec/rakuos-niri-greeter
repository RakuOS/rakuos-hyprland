#!/bin/bash
COMMAND="$1"

_confirm() {
    echo ""
    echo "⚠️  Switching greeters will log you out and change system settings."
    echo "    Only continue if you know what you are doing!"
    read -p "Do you want to continue? (y/n): " -n 1 -r
    echo ""

    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "❌ Switching canceled."
        exit 1
    fi
}

case "$COMMAND" in
    "dms")
        _confirm
        sudo rum remove noctalia-greeter
        sudo sed -i 's/command = "noctalia-greeter-session"/command = "dms-greeter --command niri"/g' /etc/greetd/config.toml
        sudo systemctl restart greetd
        ;;
    "noctalia"):
        _confirm
        sudo rum install noctalia-greeter
        sudo sed -i 's/command = "dms-greeter --command niri"/command = "noctalia-greeter-session"/g' /etc/greetd/config.toml
        sudo systemctl restart greetd
        ;;
    ""|"--help"|"help"|"*"):
        echo "Usage: rakuos-niri greeter <dms|noctalia>"
        echo ""
        echo "Avaible:"
        echo "  dms"
        echo "  noctalia"
        echo ""
        echo "Note: use dms only if you switched to noctalia and want to switch back"
        echo ""
        ;;
esac
